{
  "name": "ecom-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src server scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:dashboard-ui && npm run test:select-theme && npm run test:ux-polish",
    "preview": "node server/index.mjs --production",
    "start": "node server/index.mjs --production",
    "sync:dingtalk": "node scripts/sync-dingtalk.mjs",
    "sync:dingtalk:dry": "node scripts/sync-dingtalk.mjs --dry-run",
    "schedule:dingtalk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-dingtalk-schedule.ps1",
    "schedule:devserver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-devserver-schedule.ps1",
    "extract:power-query": "node scripts/extract-power-query.mjs",
    "test:dingtalk": "node scripts/test-dingtalk-import.mjs",
    "test:dingtalk-api": "node scripts/test-dingtalk-api.mjs",
    "test:public-surface": "node scripts/test-public-surface.mjs",
    "test:dingtalk-unattended": "node scripts/test-dingtalk-unattended-contract.mjs",
    "test:dashboard-ui": "node scripts/test-dashboard-ui-contract.mjs",
    "test:channel-health": "node --experimental-strip-types scripts/test-channel-health.mjs",
    "test:products": "node scripts/test-product-management-current-contract.mjs",
    "test:analytics-sync": "node scripts/test-analytics-sync-contract.mjs",
    "test:analytics-dashboard": "node scripts/test-warehouse-dashboard-metrics.mjs && node scripts/test-dingtalk-api.mjs && node scripts/test-dashboard-ui-contract.mjs",
    "test:ux-polish": "node scripts/test-ux-polish-contract.mjs",
    "test:powerbi-replica": "node scripts/test-powerbi-replica-contract.mjs",
    "test:powerbi-images": "node scripts/test-powerbi-image-contract.mjs",
    "test:select-theme": "node scripts/test-global-select-theme.mjs",
    "test:auth": "node scripts/test-auth-service.mjs && node scripts/test-auth-http-contract.mjs && node scripts/test-auth-http-e2e.mjs",
    "test:global-search": "node scripts/test-global-search-contract.mjs && node scripts/test-global-search-api.mjs",
    "test:smoke": "node scripts/smoke-local.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0"
  }
}
