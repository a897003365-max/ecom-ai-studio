# 通义千问 Vision API Key（DashScope）
# 阿里云百炼平台申请：https://bailian.console.aliyun.com/ → API-KEY 管理
# 本 key 用于 POST /api/intelligence/analyze-source 中的 Vision 分析步骤
# 若不填，系统降级到 Stage A 的 3 份 JSON（不会崩）
DASHSCOPE_API_KEY=

# Vision 分析并发度，默认 5。可下调到 2-3 缓解限速，或上调到 10（需 API 允许）
VISION_CONCURRENCY=5

# Vision 单次调用重试次数（HTTP 429/500/timeout 时），默认 2
VISION_MAX_RETRIES=2

# 使用哪个 Vision 模型
# qwen-vl-max: 通义千问旗舰视觉模型（推荐，中文准）
# qwen-vl-plus: 平衡版
# qwen-vl-plus-latest: 最新版
VISION_MODEL=qwen-vl-max

# Vision 分析超时（毫秒），单张图，默认 90 秒
VISION_TIMEOUT_MS=90000

# 本地账号会话时长（小时），默认 12
AUTH_SESSION_TTL_HOURS=12

# 本地开发默认 0：保留登录与权限功能，但不拦截页面/API；正式上线时必须改为 1
AUTH_ENFORCEMENT_ENABLED=0

# HTTPS / 反向代理部署时设为 1，为会话 Cookie 增加 Secure
AUTH_SECURE_COOKIE=0

# 仅当服务位于会覆盖客户端转发头的可信反向代理之后时设为 1
AUTH_TRUST_PROXY=0

# 可选：仅用于隔离测试账号库；正常运行使用 local-data/auth/auth-store.json
# AUTH_STORE_PATH=local-data/auth/auth-store.json
