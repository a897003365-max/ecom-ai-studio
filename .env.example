# 通义千问 API Key（DashScope）
# 阿里云百炼平台申请：https://bailian.console.aliyun.com/ → API-KEY 管理
# 用途一：POST /api/intelligence/analyze-source 中的 Vision 分析步骤（不填则降级到 Stage A 的 3 份 JSON）
# 用途二：小红书舆情 LLM 综合分析（server/sentiment.mjs），按 SENTIMENT_PROVIDER_ORDER 降级，当前为第 3 顺位
DASHSCOPE_API_KEY=

# 备用 DashScope key（可选）：主 DASHSCOPE_API_KEY 鉴权失败（HTTP 401/403）或调用出错时自动切换重试
# 不填也能用，仅主 key 有效
DASHSCOPE_API_KEY_BACKUP=

# Vision 分析并发度，默认 5。可下调到 2-3 缓解限速，或上调到 10（需 API 允许）
VISION_CONCURRENCY=5

# Vision 单次调用重试次数（HTTP 429/500/timeout 时），默认 2
VISION_MAX_RETRIES=2

# 使用哪个 Vision 模型
# qwen-vl-max: 通义千问旗舰视觉模型（推荐，中文准）
# qwen-vl-plus: 平衡版
# qwen-vl-plus-latest: 最新版
VISION_MODEL=qwen-vl-max

# Vision 分析超时（毫秒），单张图，默认 90 秒
VISION_TIMEOUT_MS=90000

# 本地账号会话时长（小时），默认 12
AUTH_SESSION_TTL_HOURS=12

# 本地开发默认 0：保留登录与权限功能，但不拦截页面/API；正式上线时必须改为 1
AUTH_ENFORCEMENT_ENABLED=0

# HTTPS / 反向代理部署时设为 1，为会话 Cookie 增加 Secure
AUTH_SECURE_COOKIE=0

# 仅当服务位于会覆盖客户端转发头的可信反向代理之后时设为 1
AUTH_TRUST_PROXY=0

# 可选：仅用于隔离测试账号库；正常运行使用 local-data/auth/auth-store.json
# AUTH_STORE_PATH=local-data/auth/auth-store.json

# yudao 业务管理后台（yudao-boot-mini）只读代理配置
# 服务端代理调用其 REST API 拉取商品档案、店铺渠道、竞品价格等人工维护数据
# 不配置用户名/密码时，/api/masterdata/* 接口自动降级返回空列表（页面显示降级提示，不会报错）
# 注意：密码含 # 等特殊字符时必须用双引号包裹，例如 YUDAO_PASSWORD="Ecom#2026#Studio"
YUDAO_BASE_URL=http://127.0.0.1:48080
YUDAO_USERNAME=
YUDAO_PASSWORD=
YUDAO_TENANT_ID=1

# 火山引擎 Ark API Key（Claude Code 同款订阅）
# 用于「文案与分镜」工作台的 🤖 AI 一键生成：自动产出 6 级计划 + 完整文案
# 火山 Ark 控制台申请：https://www.volcengine.com/product/ark
# 端点固定为 https://ark.cn-beijing.volces.com/api/v3/messages（Anthropic Messages API 兼容）
# 模型固定为 claude-3-5-sonnet-20241022（按需调整 server/arkProxy.mjs 中的 ARK_MODEL）
# 不带 VITE_ 前缀 → 不会打包到客户端 bundle，仅 server/arkProxy.mjs 读取
# 前端通过同源 /api/ark/call 调用，key 永远不出服务端
# 不配置时点击 AI 一键生成会弹出友好提示，不会崩
ARK_API_KEY=

# 备用 Ark key（可选）：主 ARK_API_KEY 鉴权失败（HTTP 401/403）时自动切换重试
# 使用方：server/arkProxy.mjs（文案与分镜工作台）、server/sentiment.mjs（小红书舆情），均依次尝试 ARK_API_KEY → ARK_API_KEY_BACKUP
# 不填也能用，仅主 key 有效
ARK_API_KEY_BACKUP=

# 备用 LLM · 月之暗面 Kimi API Key（可选，2026-09-07 实测速度最快的 provider）
# Kimi 开放平台申请：https://platform.moonshot.cn → 「API Key 管理」
# 使用方：server/sentiment.mjs 舆情综合分析降级链，默认 kimi → ark → dashscope
# OpenAI 兼容端点（Bearer 鉴权）；base url 可用 KIMI_BASE_URL 覆盖
# 注意：kimi-latest 别名在不少账号返回 HTTP 404；k2.6/k3 等推理模型只允许 temperature=1
KIMI_API_KEY=
# 备用 Kimi key（可选）：主 KIMI_API_KEY 调用失败时自动切换
KIMI_API_KEY_BACKUP=
# 舆情分析 Kimi 模型，默认 kimi-k2.7-code-highspeed（实测约 6s 且输出可解析 JSON）
SENTIMENT_KIMI_MODEL=kimi-k2.7-code-highspeed
# 舆情分析 provider 降级顺序（按实测响应速度排，可随时改）
#   实测：kimi(~6s) → ark(默认max推理~17s，改 medium 约7.5s) → dashscope
SENTIMENT_PROVIDER_ORDER=kimi,ark,dashscope
# 可选：Ark 推理强度（max 更准更慢 / medium ~快一倍），不填默认 max
# ARK_SENTIMENT_REASONING=medium

# 每日 Coze API 连通性检查失败时的飞书 webhook 告警（自定义机器人，HMAC-SHA256 签名）
# 优先用 FEISHU_COZE_WEBHOOK_URL/SECRET，缺省回退 FEISHU_JUSHUITAN_WEBHOOK_URL/SECRET（脚本 scripts/check-coze-api.mjs）
# 申请：飞书群 → 设置 → 群机器人 → 添加自定义机器人（复制 Webhook 地址 + 签名密钥）
FEISHU_COZE_WEBHOOK_URL=
FEISHU_COZE_WEBHOOK_SECRET=


# 天猫明细按需重算预热起点（可选，默认当年 1 月 1 日；终点固定为数据最新日）
# 服务启动 15s 后 + 每次同步后（5 分钟轮询 mtime）后台预跑，把全局筛选终点选到数据最新日可免首次重算等待
# POWERBI_PREWARM_START=2026-01-01
