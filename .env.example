# 通义千问 Vision API Key（DashScope）
# 阿里云百炼平台申请：https://bailian.console.aliyun.com/ → API-KEY 管理
# 本 key 用于 POST /api/intelligence/analyze-source 中的 Vision 分析步骤
# 若不填，系统降级到 Stage A 的 3 份 JSON（不会崩）
DASHSCOPE_API_KEY=

# Vision 分析并发度，默认 5。可下调到 2-3 缓解限速，或上调到 10（需 API 允许）
VISION_CONCURRENCY=5

# Vision 单次调用重试次数（HTTP 429/500/timeout 时），默认 2
VISION_MAX_RETRIES=2

# 使用哪个 Vision 模型
# qwen-vl-max: 通义千问旗舰视觉模型（推荐，中文准）
# qwen-vl-plus: 平衡版
# qwen-vl-plus-latest: 最新版
VISION_MODEL=qwen-vl-max

# Vision 分析超时（毫秒），单张图，默认 90 秒
VISION_TIMEOUT_MS=90000

# 本地账号会话时长（小时），默认 12
AUTH_SESSION_TTL_HOURS=12

# 本地开发默认 0：保留登录与权限功能，但不拦截页面/API；正式上线时必须改为 1
AUTH_ENFORCEMENT_ENABLED=0

# HTTPS / 反向代理部署时设为 1，为会话 Cookie 增加 Secure
AUTH_SECURE_COOKIE=0

# 仅当服务位于会覆盖客户端转发头的可信反向代理之后时设为 1
AUTH_TRUST_PROXY=0

# 可选：仅用于隔离测试账号库；正常运行使用 local-data/auth/auth-store.json
# AUTH_STORE_PATH=local-data/auth/auth-store.json

# yudao 业务管理后台（yudao-boot-mini）只读代理配置
# 服务端代理调用其 REST API 拉取商品档案、店铺渠道、竞品价格等人工维护数据
# 不配置用户名/密码时，/api/masterdata/* 接口自动降级返回空列表（页面显示降级提示，不会报错）
# 注意：密码含 # 等特殊字符时必须用双引号包裹，例如 YUDAO_PASSWORD="Ecom#2026#Studio"
YUDAO_BASE_URL=http://127.0.0.1:48080
YUDAO_USERNAME=
YUDAO_PASSWORD=
YUDAO_TENANT_ID=1

# 火山引擎 Ark API Key（Claude Code 同款订阅）
# 用于「文案与分镜」工作台的 🤖 AI 一键生成：自动产出 6 级计划 + 完整文案
# 火山 Ark 控制台申请：https://www.volcengine.com/product/ark
# 端点固定为 https://ark.cn-beijing.volces.com/api/v3/messages（Anthropic Messages API 兼容）
# 模型固定为 claude-3-5-sonnet-20241022（按需调整 server/arkProxy.mjs 中的 ARK_MODEL）
# 不带 VITE_ 前缀 → 不会打包到客户端 bundle，仅 server/arkProxy.mjs 读取
# 前端通过同源 /api/ark/call 调用，key 永远不出服务端
# 不配置时点击 AI 一键生成会弹出友好提示，不会崩
ARK_API_KEY=

