    调用自定义函数1 = Table.AddColumn(筛选的隐藏文件1, "转换文件 (23)", each #"转换文件 (23)"([Content])),
    重命名的列1 = Table.RenameColumns(调用自定义函数1, {"Name", "Source.Name"}),
