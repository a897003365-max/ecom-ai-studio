table 07-旗舰店商品销售数据
	lineageTag: 1a636adc-0ad4-4bae-908c-d6062c07552d

	measure 访客转化率 =
			
			DIVIDE(SUM('07-旗舰店商品销售数据'[支付买家数]), SUM('07-旗舰店商品销售数据'[商品访客数]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 48414b6c-36fd-490a-bd1c-be16d27099b1

	measure 退款金额占比 =
			
			DIVIDE(SUM('07-旗舰店商品销售数据'[退款金额]), SUM('07-旗舰店商品销售数据'[支付金额]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ba0e008f-3435-4091-8db0-bae3505a0114

	measure 商品加购率 =
			
			DIVIDE(SUM('07-旗舰店商品销售数据'[加购人数]), SUM('07-旗舰店商品销售数据'[商品访客数]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d3cf13f4-32fe-406f-ad4c-15ee05489aff

	measure TOP3支付金额总和 =
			
			VAR RankedTable =
			    SUMMARIZE(
			        ALLSELECTED('07-旗舰店商品销售数据'),
			        '07-旗舰店商品销售数据'[商品ID],
			        "商品减退金额", '07-旗舰店商品销售数据'[商品减退金额（万）]
			    )
			VAR Top3 =
			    TOPN(
			        3,
			        RankedTable,
			        [商品减退金额], DESC
			    )
			RETURN
			    SUMX(Top3, [商品减退金额])
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
		lineageTag: 51071b0a-4fa5-4b20-8fc1-0e8537df183c

		annotation PBI_FormatHint = {"currencyCulture":"zh-CN"}

	measure 商品TOP3减退金额占比 = DIVIDE('07-旗舰店商品销售数据'[TOP3支付金额总和], '07-旗舰店商品销售数据'[商品减退金额（万）])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 478887d3-7ab0-450b-997d-89fa6b9a2b86

