	measure 商品减退金额（万） = divide((SUM('07-旗舰店商品销售数据'[支付金额])-SUM('07-旗舰店商品销售数据'[退款金额])),10000)
		lineageTag: 1f782c29-85a6-4396-bee1-486967ca140a

		formatStringDefinition = "0.00万"

	measure 商品支付金额（万） = DIVIDE(SUM('07-旗舰店商品销售数据'[支付金额]), 10000)
		lineageTag: 7e906d5d-2117-4367-8ee5-41f4011bd0f5

		formatStringDefinition = "0.00万"

	measure 件单价 = divide(SUM('07-旗舰店商品销售数据'[支付金额]),SUM('07-旗舰店商品销售数据'[商品支付件数]))
		formatString: #,0
		lineageTag: c725dcec-3c71-4847-a686-8d920dbcc437

	measure 商品减退金额占比 =
			
			DIVIDE(
			    [商品减退金额（万）],
			    CALCULATE(
			        [商品减退金额（万）],
			        ALLSELECTED()
			))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5d54ab37-a048-4dbf-af4f-6d52033652b1

	measure 商品减退金额 = [商品减退金额（万）]*10000
		formatString: #,0
		lineageTag: 9e8fea3b-85de-4e07-9fdb-fecd588c3f93

	measure 客单价（商品） =
			
			DIVIDE(SUM('07-旗舰店商品销售数据'[支付金额]), SUM('07-旗舰店商品销售数据'[支付买家数]))
		lineageTag: 6f475773-0b86-45c4-8569-09b39e8e9956

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 商品费比 =
			
			DIVIDE([花费(万)], [商品减退金额（万）])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f2106023-0dda-46f1-ba9d-982027163540

	measure 支付件数（排除补差） =
			CALCULATE(
			    SUM('07-旗舰店商品销售数据'[商品支付件数]),
			    NOT (CONTAINSSTRING('07-旗舰店商品销售数据'[商品名称], "差价") )
			)
		formatString: 0
		lineageTag: cd9ff64b-02ff-4a7b-bb9a-e3ffa77df66a

	measure 国补后费比 = divide([花费(万)],[商品减退金额（万）]*0.85)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f3ebbe40-6185-435f-9cb6-c2bec90fb503

	measure 国补后金额(万) = [商品减退金额（万）]*0.85
		lineageTag: b594bdc6-6398-4d96-b30a-c2ce77a2dc10

		formatStringDefinition = "0.00万"

	measure 去年国补后金额（万） = ```
			CALCULATE( [国补后金额(万)] , 
			   DATEADD( '01-店铺数据辅助表'[日期].[Date], -365 , DAY ) )
			```
		lineageTag: ac8ff2c5-a024-4c75-96c4-ccf2fdc1945c

		formatStringDefinition = "0.00万"

	measure 国补后金额同比 = DIVIDE(([国补后金额(万)]-[去年国补后金额（万）]),[去年国补后金额（万）])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 91b4abb0-b87f-4874-a185-ce21b28403f0

