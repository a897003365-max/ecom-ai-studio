table 10-2京东客服营销明细
	lineageTag: 539f958b-bbd0-4bde-b5bb-f81ce7c5e355

	measure 接待量环比 =
			
			VAR CurrentValue = sum('10-2京东客服营销明细'[接待量])
			VAR PreviousValue = CALCULATE(sum('10-2京东客服营销明细'[接待量]), DATEADD('01-店铺数据辅助表'[日期].[Date], -1 , DAY ))
			RETURN
			DIVIDE(CurrentValue - PreviousValue, PreviousValue, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 059a0f17-c166-43e8-ae8a-e986e69ef7d8

	measure 30S应答率环比 =
			
			VAR CurrentValue = sum('10-2京东客服营销明细'[30s应答率])
			VAR PreviousValue = CALCULATE(sum('10-2京东客服营销明细'[30s应答率]), DATEADD('01-店铺数据辅助表'[日期].[Date], -1 , DAY ))
			RETURN
			DIVIDE(CurrentValue - PreviousValue, PreviousValue, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: de88d9af-fcc2-4435-bab7-223f5b544570

	measure 首响京东环比 =
			
			VAR CurrentValue = sum('10-2京东客服营销明细'[首次平均响应时间])
			VAR PreviousValue = CALCULATE(sum('10-2京东客服营销明细'[首次平均响应时间]), DATEADD('01-店铺数据辅助表'[日期].[Date], -1 , DAY ))
			RETURN
			DIVIDE(CurrentValue - PreviousValue, PreviousValue, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2abbd218-bb5f-43ce-b85c-0560cdae419f

	measure 京东班次 =
			
			VAR CurrentDate =MIN('10-2京东客服营销明细'[日期])
			VAR CurrentNickname = MIN('京东客服分组表'[客服])
			RETURN
			MAXX(
			    FILTER(
			        '淘宝客服排班表',
			        '淘宝客服排班表'[旺旺昵称] = CurrentNickname &&
			        CurrentDate >= '淘宝客服排班表'[开始时间] &&
			        CurrentDate <= '淘宝客服排班表'[结束时间]
			    ),
			    '淘宝客服排班表'[班次]
			)
		lineageTag: 33972b3f-cf8f-47ef-8a2d-c36ced89ebda

