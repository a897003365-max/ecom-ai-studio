table 10-3京东客服绩效数据
	lineageTag: aa7b6532-8182-448d-80d5-234e3fef4c5f

	measure 客单价（客服） = DIVIDE(sum('10-3京东客服绩效数据'[促成下单商品金额]),sum('10-3京东客服绩效数据'[促成下单人数]))
		formatString: 0
		lineageTag: de814bbc-d89e-4c6a-862b-80d5474e2efe

	measure 转化率京东客服 = DIVIDE(SUM('10-3京东客服绩效数据'[促成下单人数]), SUM('10-3京东客服绩效数据'[售前接待人数]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b4bd12aa-1a98-4826-979b-02b5d5911285

	measure 促成金额环比 =
			
			VAR CurrentValue = sum('10-3京东客服绩效数据'[促成下单商品金额])
			VAR PreviousValue = CALCULATE(sum('10-3京东客服绩效数据'[促成下单商品金额]), DATEADD('01-店铺数据辅助表'[日期].[Date], -1 , DAY ))
			RETURN
			DIVIDE(CurrentValue - PreviousValue, PreviousValue, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 290abc3f-773e-4b0b-99b0-14c235266664

	measure 客单价客服环比 =
			
			VAR CurrentValue = [客单价（客服）]
			VAR PreviousValue = CALCULATE( [客单价（客服）], DATEADD('01-店铺数据辅助表'[日期].[Date], -1 , DAY ))
			RETURN
			DIVIDE(CurrentValue - PreviousValue, PreviousValue, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a52f3612-4fec-4c88-9ed2-60bc8958f8f1

	measure 转化率客服环比 =
			
			VAR CurrentValue =[转化率京东客服]
			VAR PreviousValue = CALCULATE([转化率京东客服], DATEADD('01-店铺数据辅助表'[日期].[Date], -1 , DAY ))
			RETURN
			DIVIDE(CurrentValue - PreviousValue, PreviousValue, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4f9fb710-c44d-412d-9751-6f5b8a19ad1d

	measure 促成下单金额（万） = divide(SUM('10-3京东客服绩效数据'[促成下单商品金额]),10000)
